# Admin heslo je nyní POUZE na serveru (functions/.env → ADMIN_PASSWORD)
# VITE_ADMIN_PASSWORD už není potřeba – ověření probíhá přes Cloud Function

# Firebase – povinné pro načtení dat (lokální dev)
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_APP_ID=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# EmailJS (volitelné – potvrzení rezervací)
# VITE_EMAILJS_SERVICE_ID=...
# VITE_EMAILJS_CONFIRM_TEMPLATE_ID=...
# VITE_EMAILJS_PUBLIC_KEY=...

# Instagram (volitelné)
# VITE_INSTAGRAM_URL=https://www.instagram.com/...
# VITE_INSTAGRAM_POST_URLS=...

# Google recenze (volitelné)
# VITE_GOOGLE_REVIEW_URL=...
# VITE_GOOGLE_PLACES_API_KEY=...
# VITE_GOOGLE_PLACE_ID=...
# Recenze se drží v src/constants/googleReviews.js
