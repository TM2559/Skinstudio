# Admin: heslo v .env musí sedět s ADMIN_PASSWORD ve functions (Cloud Function verifyAdminPassword).
VITE_ADMIN_PASSWORD=your-admin-password

# Produkce / CI: Resend přes Cloud Functions (výchozí v GitHub Actions)
# VITE_USE_RESEND_EMAILS=true
# VITE_USE_EMULATORS=false

# Lokální test Resend + emulátor funkcí: VITE_USE_EMULATORS=true + VITE_USE_RESEND_EMAILS=true, pak z salon-system: firebase emulators:start --only functions, ve functions/.env RESEND_*.
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001

# Firebase – povinné pro načtení dat (lokální dev)
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_APP_ID=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Galerie a proměny: na lokále se čte i z artifacts (výchozí app id je default-app-id). Jiný app id z Canvasu:
# VITE_FIREBASE_ARTIFACTS_APP_ID=default-app-id

# E-maily: výchozí = EmailJS z prohlížeče (doplň ID šablon). Resend = nastav VITE_USE_RESEND_EMAILS=true a nasaď funkce + RESEND_* ve functions.
# VITE_USE_RESEND_EMAILS=
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_CONFIRM_TEMPLATE_ID=
# VITE_EMAILJS_REMINDER_TEMPLATE_ID=
# VITE_EMAILJS_ADMIN_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Instagram (volitelné)
# VITE_INSTAGRAM_URL=https://www.instagram.com/...
# VITE_INSTAGRAM_POST_URLS=...

# Google recenze (volitelné)
# VITE_GOOGLE_REVIEW_URL=...
# VITE_GOOGLE_PLACES_API_KEY=...
# VITE_GOOGLE_PLACE_ID=...
# Recenze se drží v src/constants/googleReviews.js
