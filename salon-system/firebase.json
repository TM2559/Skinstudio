{
  "hosting": {
    "predeploy": ["npm run build"],
    "public": "dist",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/@(kosmetika|pmu|rezervace|darkove-poukazy)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(jpg|jpeg|png|webp|svg|ico)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ],
    "redirects": [
      { "source": "/recenze", "destination": "https://g.page/r/CWkt9xHMgMjqEAE/review", "type": 302 }
    ],
    "rewrites": [
      { "source": "/api/format-content", "function": { "functionId": "formatContent", "region": "europe-west1" } },
      { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
      { "source": "/robots.txt", "destination": "/robots.txt" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
