# Admin WebAuthn (Face ID) – musí být stejné jako VITE_ADMIN_PASSWORD v salon-system/.env
ADMIN_PASSWORD=your-secret-password

# BulkGate SMS (volitelné – pro připomínky a potvrzení)
# BULKGATE_APPLICATION_ID=
# BULKGATE_APPLICATION_TOKEN=
# BULKGATE_SENDER_ID=
# BULKGATE_SENDER_ID_VALUE=

# Gemini API (volitelné – pro Magic Wand v adminu)
# GEMINI_API_KEY=

# Vlastní doména pro Face ID (volitelné) – hostname oddělené čárkou, např. rezervace.skinstudio.cz
# WEBAPP_ORIGIN_HOSTS=

# Resend (e-maily z callable + sendDailyReminders – pokud je vyplněné, má přednost před EmailJS u plánovače)
# RESEND_API_KEY=re_...
# RESEND_FROM=Skin Studio <noreply@example.cz>
# RESEND_REPLY_TO=rezervace@skinstudio.cz
# RESEND_ADMIN_TO=rezervace@skinstudio.cz

# EmailJS – fallback pro sendDailyReminders, když RESEND není nastaven (stejné hodnoty jako VITE_EMAILJS_* na frontendu)
# EMAILJS_SERVICE_ID=
# EMAILJS_REMINDER_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
